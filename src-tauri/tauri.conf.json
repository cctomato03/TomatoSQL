{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomatoSQL",
  "version": "1.0.5",
  "identifier": "com.tomatosql.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TomatoSQL",
        "width": 1460,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://*:* https://*:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 TomatoSQL",
    "category": "DeveloperTool",
    "shortDescription": "TomatoSQL 数据库管理工具",
    "longDescription": "TomatoSQL 是一个跨平台的数据库管理工具，支持 MySQL 与 SQLite，提供连接管理、数据导入导出、结构迁移与同步、云同步等能力。",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
